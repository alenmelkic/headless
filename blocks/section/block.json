{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "acf/section",
  "title": "Section",
  "description": "Generic section wrapper with background, padding, and inner blocks support.",
  "category": "theme",
  "icon": "layout",
  "keywords": ["section", "wrapper", "container", "layout"],
  "acf": {
    "version": 3,
    "mode": "preview",
    "renderTemplate": "blocks/section/render.php"
  },
  "supports": {
    "anchor": true,
    "html": false,
    "align": ["wide", "full"],
    "jsx": true,
    "spacing": {
      "margin": true,
      "padding": false
    }
  }
}
